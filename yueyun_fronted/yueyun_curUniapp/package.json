    "@dcloudio/uni-mp-weixin": "^2.0.0",
    "@dcloudio/uni-template-compiler": "^2.0.0",
    "@dcloudio/vue-cli-plugin-uni": "^2.0.0",
    "@dcloudio/webpack-uni-mp-loader": "^2.0.0",
    "cross-env": "^7.0.3",
    "vue-template-compiler": "2.7.16"
  },
  "browserslist": [
    "Android >= 4.4",
    "ios >= 8"
  ],
  "uni-app": {
    "scripts": {}
