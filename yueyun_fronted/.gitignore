# ════════════════════════════════════════════════════════════
#  悦选商城 .gitignore
#  项目: yuexuan-mall / yuexuan-admin
#  技术栈: Spring Boot 3.3 (Maven) + Vue 3 (Vite) + Element Plus
# ════════════════════════════════════════════════════════════

# ─── Java / Maven 构建输出 ────────────────────────────────
target/
*.class
*.jar
*.war
*.ear
*.zip
*.tar.gz
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
dependency-reduced-pom.xml

# ─── Node.js / 前端构建输出 ──────────────────────────────
yueyun_AdminUI/node_modules/
yueyun_AdminUI/dist/
yueyun_AdminUI/.vite/
yueyun_userUI/node_modules/
yueyun_userUI/dist/
yueyun_userUI/.vite/

# ─── npm 调试日志 ─────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── 运行时日志 ──────────────────────────────────────────
logs/
*.log

# ─── IDE 配置文件 ────────────────────────────────────────
.idea/
*.iml
*.ipr
*.iws
.classpath
.project
.settings/
.vscode/
*.sublime-project
*.sublime-workspace

# ─── 环境配置（敏感信息）────────────────────────────────
application-dev.yml
application-prod.yml
application-test.yml
*.local.yml
application-local.yml

# ─── 操作系统文件 ────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ─── 编辑器临时文件 ─────────────────────────────────────
*.swp
*.swo
*~
*.bak
*.tmp

# ─── MyBatis-Plus 代码生成器输出 ─────────────────────────
# 如果使用代码生成器生成的额外文件可以放在这里

# ─── Spring Boot 热部署 ─────────────────────────────────
.hotReload/

# ─── Dump 文件 ──────────────────────────────────────────
*.dump
*.hprof
heapdump.*

# ─── 其他 ───────────────────────────────────────────────
.settings/
.factorypath
.springBeans
.sts4-cache/
